# Copy to .env.local for `vercel dev`, and set the same two values in the Vercel
# project under Settings > Environment Variables. Both are server-side only —
# they must never appear in a VITE_ variable, because those are compiled into
# the page the students load.

# The Apps Script web app URL, ending in /exec.
# Deploy > Manage deployments > copy the Web app URL.
GAS_EXEC_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec

# The value printed by the Sheet's Team Draft > Set proxy secret menu item.
GAS_PROXY_SECRET=PASTE_PROXY_SECRET
