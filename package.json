{
  "name": "team-draft-day",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Blind team draft for class projects: wheel of names, private captain dashboard, projector reveals, and a drag-and-drop admin board. Runs on Google Apps Script.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-gas.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "push": "npm run build && clasp push"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "svelte-dnd-action": "^0.9.79"
  }
}
